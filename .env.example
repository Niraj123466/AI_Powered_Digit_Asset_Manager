# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Media Storage
MEDIA_ROOT=./data/media

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://dam:dam@localhost:5432/dam

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=dam_

# Embedding Provider
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=clip-ViT-B-32
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32

# Vision Provider
VISION_PROVIDER=ollama
VISION_MODEL=llava:7b
VISION_BASE_URL=http://localhost:11434
VISION_TIMEOUT=120

# OCR Provider
OCR_PROVIDER=tesseract
OCR_LANGUAGES=eng
OCR_DPI=300
ENABLE_OCR=true

# Transcription Provider
TRANSCRIPTION_PROVIDER=faster_whisper
TRANSCRIPTION_MODEL=base
TRANSCRIPTION_DEVICE=auto
TRANSCRIPTION_COMPUTE_TYPE=auto
ENABLE_VIDEO_TRANSCRIPTION=false

# LLM Provider
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Reranker (Optional)
RERANKER_PROVIDER=none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Video Processing
VIDEO_MAX_FRAMES=64
VIDEO_SAMPLE_INTERVAL_SECONDS=5
VIDEO_FFMPEG_PATH=ffmpeg

# PDF Processing
PDF_OCR_THRESHOLD_CHARS_PER_PAGE=100
PDF_MAX_PAGES_PER_CHUNK=1

# Ingestion Pipeline
INGESTION_WORKERS=2
INGESTION_BATCH_SIZE=10
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_BASE_DELAY=60

# Search Configuration
SEMANTIC_WEIGHT=0.60
LEXICAL_WEIGHT=0.20
MODALITY_WEIGHT=0.10
METADATA_WEIGHT=0.10
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=100
SEARCH_RRF_K=60

# Modality Detection Keywords
MODALITY_VIDEO_KEYWORDS=video,clip,footage,movie,film
MODALITY_IMAGE_KEYWORDS=image,photo,picture,snapshot,pic
MODALITY_DOCUMENT_KEYWORDS=document,pdf,brochure,floor plan,plan,report

# Hardware Detection
AUTO_DETECT_HARDWARE=true
FORCE_CPU=false

# File Extensions (comma-separated)
SUPPORTED_IMAGE_EXTS=jpg,jpeg,png,webp
SUPPORTED_VIDEO_EXTS=mp4,mov,mkv,avi,webm
SUPPORTED_DOC_EXTS=pdf

# Ignore Patterns (glob, comma-separated)
IGNORE_PATTERNS=*.tmp,*.temp,*.DS_Store,Thumbs.db,.git/*,__pycache__/*,node_modules/*,*.log

# Frontend
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000